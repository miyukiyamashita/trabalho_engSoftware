# Copie este arquivo para .env e preencha os valores.

# Porta da API NestJS
PORT=3000

# Endereço do json-server (acessado SOMENTE pelo backend)
DB_URL=http://localhost:3001

# Chave usada para assinar os tokens JWT (use um valor longo e aleatório)
JWT_SECRET=troque-esta-chave
JWT_EXPIRES_IN=1d

# Origem do frontend liberada no CORS
FRONTEND_URL=http://localhost:5173

# SMTP para envio de credenciais. Deixe SMTP_USER vazio para o "modo demonstração":
# a senha gerada é exibida uma única vez para quem fez o cadastro.
SMTP_SERVICE=gmail
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sistema CRESCE" <no-reply@cresce.local>

# Pasta onde os relatórios finais (PDF) são gravados (fora de qualquer pasta pública)
RELATORIOS_DIR=storage/relatorios
